TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional for this plugin. Without it, Codex or Claude supplies text on needs_text.
# When set, upstream Jev uses this OpenAI-compatible helper for TYPE_TEXT.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
